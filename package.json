{
  "name": "poosta-skincare-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "api": "node server.js",
    "seed:products": "node scripts/import-products-local.mjs",
    "seed:license": "node scripts/seed-license.mjs",
    "db:backup": "node scripts/backup-sqlite.mjs",
    "dataset:export": "node scripts/export-training-dataset.mjs",
    "smoke:v1": "node scripts/smoke-v1.mjs",
    "smoke:openai": "node scripts/smoke-openai-provider.mjs",
    "ai:install": "python -m pip install -r ai/requirements.txt",
    "ai:train": "python ai/train_acne.py",
    "ai:export": "python ai/export_model.py"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "sharp": "^0.35.4",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.4"
  }
}
