PORT=8787

# Pharmacy V1 licensing / storage
POOSTA_DATA_DIR=data
# false = local dev without device activation; true = require activation on tablets
POOSTA_LICENSE_REQUIRED=false
POOSTA_SUBSCRIPTION_GRACE_DAYS=3
POOSTA_ADMIN_KEY=change-me-admin

# Public URL used inside SMS links (tablet/customer phones must reach this)
POOSTA_PUBLIC_BASE_URL=http://127.0.0.1:5173
POOSTA_ROUTINE_SHARE_DAYS=30

# Kavenegar SMS (optional — without key, share still works and link is logged to server console)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Optional premium analysis providers, used ONLY when the user taps
# "شروع تحلیل با دقت" (mode=accurate). "شروع تحلیل معمولی" (mode=standard)
# never calls these -- fully local, always free, image never leaves the server.
# Server-side only, never exposed to the browser.

# 1) OpenAI Vision (tried first if configured). ChatGPT Plus does not include API usage.
#    Create a separate API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_DAILY_LIMIT=200

# 2) Gemini fallback -- https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_LIMIT=500

# 3) OpenRouter fallback (model availability changes; verify before production)
#    https://openrouter.ai/keys -- model list: https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free
OPENROUTER_DAILY_LIMIT=180

# Local model fallback (always available, no key needed):
# LOCAL_SKIN_MODEL=models/skin

# NOTE: Scans store private training assets under data/scans/.
# Never auto-retrain from those files — run ai:train yourself when ready.
